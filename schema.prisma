generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIREZIONE
  SEGRETERIA
  AMMINISTRAZIONE
  RESPONSABILE_SEDE
  PERSONALE
}

enum Priority {
  BASSA
  NORMALE
  ALTA
  URGENTE
}

enum PracticeStatus {
  APERTA
  IN_LAVORAZIONE
  IN_ATTESA
  COMPLETATA
  ANNULLATA
}

enum Category {
  AMMINISTRAZIONE
  PERSONALE
  ACQUISTI
  FORNITORI
  MANUTENZIONE
  UTENZE
  DOCUMENTI
  OPERATIVO
  ALTRO
}

model Site {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  practices Practice[]
  users     User[]
  invoices  Invoice[]
  purchases Purchase[]
  staff     StaffRecord[]
  maintenance Maintenance[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(SEGRETERIA)
  active       Boolean   @default(true)
  siteId       String?
  site         Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  practices    Practice[] @relation("AssignedPractices")
  created      Practice[] @relation("CreatedPractices")
  events       AuditEvent[]
  notes        Note[]
  documents    Document[]
  invoices     Invoice[]
  purchases    Purchase[]
  maintenance  Maintenance[]
}

model Practice {
  id          String         @id @default(cuid())
  code        String         @unique
  title       String
  description String
  category    Category       @default(ALTRO)
  priority    Priority       @default(NORMALE)
  status      PracticeStatus @default(APERTA)
  openedAt    DateTime       @default(now())
  dueAt       DateTime?
  closedAt    DateTime?
  siteId      String
  site        Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  assigneeId  String?
  assignee    User?          @relation("AssignedPractices", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User           @relation("CreatedPractices", fields: [createdById], references: [id], onDelete: Restrict)
  notes       Note[]
  documents   Document[]
  events      AuditEvent[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([siteId, status])
  @@index([dueAt, status])
  @@index([category, priority])
}

model Note {
  id         String   @id @default(cuid())
  body       String
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
}

model Document {
  id           String   @id @default(cuid())
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  details    Json?
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  @@index([practiceId, createdAt])
  @@index([actorId, createdAt])
}


enum InvoiceStatus {
  DA_VERIFICARE
  DA_PAGARE
  PAGATA
  CONTESTATA
}

enum PurchaseStatus {
  RICHIESTA
  APPROVATA
  ORDINATA
  CONSEGNATA
  ANNULLATA
}

enum MaintenanceStatus {
  SEGNALATA
  ASSEGNATA
  IN_CORSO
  COMPLETATA
  ANNULLATA
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  vatNumber   String?
  email       String?
  phone       String?
  notes       String?
  active      Boolean    @default(true)
  invoices    Invoice[]
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([name])
}

model Invoice {
  id           String        @id @default(cuid())
  number       String
  supplierId   String
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  siteId       String?
  site         Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  issueDate    DateTime
  dueDate      DateTime?
  amountCents  Int
  status       InvoiceStatus @default(DA_VERIFICARE)
  description  String
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@unique([supplierId, number])
  @@index([status, dueDate])
}

model Purchase {
  id            String        @id @default(cuid())
  code          String        @unique
  description   String
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  siteId        String
  site          Site          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  quantity      Decimal       @default(1) @db.Decimal(12, 3)
  estimatedCents Int?
  status        PurchaseStatus @default(RICHIESTA)
  requestedById String
  requestedBy   User          @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([siteId, status])
}

model StaffRecord {
  id          String   @id @default(cuid())
  name        String
  roleTitle   String
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  startDate   DateTime?
  endDate     DateTime?
  expiryDate  DateTime?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([siteId, active])
}

model Maintenance {
  id           String            @id @default(cuid())
  code         String            @unique
  title        String
  description  String
  siteId       String
  site         Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  priority     Priority          @default(NORMALE)
  status       MaintenanceStatus @default(SEGNALATA)
  dueAt        DateTime?
  supplierName String?
  costCents    Int?
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  @@index([siteId, status])
  @@index([dueAt, status])
}

model Counter {
  key   String @id
  value Int    @default(0)
}
